# Local execution environments and generated data are not source code.
/runtime/
/.venv/
/venv/
__pycache__/
*.py[cod]
/captures/
/logs/

# Keep the portable launch configuration and the small required SCNN weights,
# even if the parent team repository ignores .vscode/ or *.pth.
!/.vscode/
!/.vscode/*.json
!/models/*.pth
